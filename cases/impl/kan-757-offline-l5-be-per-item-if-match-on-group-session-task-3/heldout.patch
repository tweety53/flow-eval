+package com.gymie.groupsession.infrastructure.presentation.web
+
+import com.gymie.groupsession.core.domain.groupsession.specification.ParticipantProfile
+import com.gymie.groupsession.core.services.groupsession.GroupSessionQueryService
+import com.gymie.workout.core.domain.workout.SetEffort
+import com.gymie.workout.core.domain.workout.SetValues
+import com.gymie.workout.core.domain.workout.SetWeight
+import com.gymie.workout.core.domain.workout.WeightUnit
+import com.gymie.workout.core.domain.workout.Workout
+import com.gymie.workout.core.domain.workout.WorkoutLifecycle
+import com.gymie.workout.core.domain.workout.WorkoutSet
+import com.gymie.workout.core.domain.workout.WorkoutStatus
+import com.gymie.workout.core.exceptions.WorkoutSetChangedException
+import com.gymie.workout.core.services.workout.WorkoutFieldPatchService
+import com.gymie.workout.core.services.workout.WorkoutFinishReadinessService
+import com.gymie.workout.core.services.workout.WorkoutService
+import com.gymie.workout.infrastructure.presentation.web.WorkoutExceptionHandler
+import com.gymie.workout.infrastructure.presentation.web.WorkoutResponseAssembler
+import com.gymie.workout.infrastructure.presentation.web.dto.WorkoutResponse
+import io.mockk.clearMocks
+import io.mockk.every
+import io.mockk.mockk
+import io.mockk.verify
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.context.TestConfiguration
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest
+import org.springframework.context.annotation.Bean
+import org.springframework.context.annotation.Import
+import org.springframework.http.MediaType
+import org.springframework.security.test.web.servlet.request.SecurityMockMvcRequestPostProcessors.csrf
+import org.springframework.security.test.web.servlet.request.SecurityMockMvcRequestPostProcessors.user
+import org.springframework.test.web.servlet.MockMvc
+import org.springframework.test.web.servlet.patch
+import java.math.BigDecimal
+import java.time.Instant
+import java.time.LocalDate
+import java.util.UUID
+
+/**
+ * The floor set PATCH's compare-and-set (KAN-757, decisions `value-compare-and-set`,
+ * `floor-set-request-dto` and `set-changed-mapped-in-groupsession`): `expected` reaches the service
+ * with the driver as the actor, and a stale one answers `409 set_changed` naming who last changed the set.
+ */
+@WebMvcTest(controllers = [GroupSessionWorkoutController::class])
+@Import(
+    GroupSessionWorkoutController::class,
+    GroupSessionExceptionHandler::class,
+    WorkoutExceptionHandler::class,
+    GroupSessionFloorSetConflictTest.TestConfig::class,
+)
+class GroupSessionFloorSetConflictTest {
+    @Autowired lateinit var mockMvc: MockMvc
+
+    @Autowired lateinit var queryService: GroupSessionQueryService
+
+    @Autowired lateinit var patchService: WorkoutFieldPatchService
+
+    @Autowired lateinit var responses: WorkoutResponseAssembler
+
+    private val owner = UUID.fromString("11111111-1111-1111-1111-111111111111")
+    private val jana = UUID.fromString("22222222-2222-2222-2222-222222222222")
+    private val otherDriver = UUID.fromString("33333333-3333-3333-3333-333333333333")
+    private val sessionId = UUID.randomUUID()
+    private val workoutId = UUID.randomUUID()
+    private val setId = UUID.randomUUID()
+    private val changedAt = Instant.parse("2026-10-07T09:30:00Z")
+
+    private val workout =
+        Workout(
+            id = workoutId,
+            userId = jana,
+            scheduledDate = LocalDate.of(2026, 10, 7),
+            unit = WeightUnit.KG,
+            lifecycle = WorkoutLifecycle(status = WorkoutStatus.PLANNED),
+        )
+
+    @BeforeEach
+    fun setUp() {
+        clearMocks(queryService, patchService, responses)
+        every { queryService.participantWorkoutIdForWrite(owner, sessionId, jana) } returns workoutId
+    }
+
+    @Test
+    fun `expected reaches the service with the driver as actor`() {
+        val expected = SetValues(SetWeight.Measured(BigDecimal("60")), SetEffort.Count(10), confirmed = false)
+        every {
+            patchService.patchSet(jana, workoutId, setId, SetWeight.Measured(BigDecimal("65")), SetEffort.Max, true, owner, expected)
+        } returns workout
+        every { responses.respond(workout) } returns response()
+
+        patchSet(
+            """
+            {"weight":{"kind":"MEASURED","value":65},"effort":{"kind":"MAX"},"confirmed":true,
+             "expected":{"weight":{"kind":"MEASURED","value":60},"effort":{"kind":"COUNT","value":10},"confirmed":false}}
+            """.trimIndent(),
+        ).andExpect { status { isOk() } }
+
+        verify { patchService.patchSet(jana, workoutId, setId, SetWeight.Measured(BigDecimal("65")), SetEffort.Max, true, owner, expected) }
+    }
+
+    @Test
+    fun `a set_changed refusal carries current updatedBy and updatedAt`() {
+        val current =
+            WorkoutSet(
+                id = setId,
+                position = 0,
+                weight = SetWeight.Measured(BigDecimal("70.00")),
+                effort = SetEffort.Count(8),
+                confirmedAt = changedAt,
+                updatedAt = changedAt,
+                updatedBy = otherDriver,
+            )
+        every { patchService.patchSet(any(), any(), any(), any(), any(), any(), any(), any()) } throws WorkoutSetChangedException(current)
+        every { queryService.profileOf(otherDriver) } returns ParticipantProfile(otherDriver, "Marko Novak", "marko", null, null)
+
+        patchSet(STALE_BODY).andExpect {
+            status { isConflict() }
+            jsonPath("$.code") { value("set_changed") }
+            jsonPath("$.detail") { value("This set was changed on another phone.") }
+            jsonPath("$.current.weight.kind") { value("MEASURED") }
+            jsonPath("$.current.weight.value") { value(70.0) }
+            jsonPath("$.current.effort.kind") { value("COUNT") }
+            jsonPath("$.current.effort.value") { value(8) }
+            jsonPath("$.current.confirmed") { value(true) }
+            jsonPath("$.updatedBy.id") { value(otherDriver.toString()) }
+            jsonPath("$.updatedBy.displayName") { value("Marko Novak") }
+            jsonPath("$.updatedAt") { value("2026-10-07T09:30:00Z") }
+        }
+    }
+
+    @Test
+    fun `a never-stamped set answers null updatedBy and updatedAt`() {
+        val current = WorkoutSet(id = setId, position = 0, weight = SetWeight.Bodyweight)
+        every { patchService.patchSet(any(), any(), any(), any(), any(), any(), any(), any()) } throws WorkoutSetChangedException(current)
+
+        patchSet(STALE_BODY).andExpect {
+            status { isConflict() }
+            jsonPath("$.code") { value("set_changed") }
+            jsonPath("$.current.weight.kind") { value("BW") }
+            jsonPath("$.current.confirmed") { value(false) }
+            jsonPath("$.updatedBy") { doesNotExist() }
+            jsonPath("$.updatedAt") { doesNotExist() }
+        }
+    }
+
+    @Test
+    fun `an unknown field is still refused`() {
+        patchSet("""{"weight":null,"effort":null,"confirmed":true,"foo":1}""").andExpect { status { isBadRequest() } }
+
+        verify(exactly = 0) { patchService.patchSet(any(), any(), any(), any(), any(), any(), any(), any()) }
+    }
+
+    private fun patchSet(body: String) =
+        mockMvc.patch("/api/group-sessions/$sessionId/participants/$jana/workout/sets/$setId") {
+            with(user(owner.toString()))
+            with(csrf())
+            contentType = MediaType.APPLICATION_JSON
+            content = body
+        }
+
+    private fun response() =
+        WorkoutResponse(
+            id = workoutId,
+            scheduledDate = workout.scheduledDate,
+            scheduledTime = null,
+            unit = WeightUnit.KG,
+            name = null,
+            displayName = "Stub",
+            notes = null,
+            status = WorkoutStatus.PLANNED,
+            startedAt = null,
+            finishedAt = null,
+            blocks = emptyList(),
+        )
+
+    @TestConfiguration
+    class TestConfig {
+        @Bean
+        fun groupSessionQueryService(): GroupSessionQueryService = mockk()
+
+        @Bean
+        fun workoutService(): WorkoutService = mockk()
+
+        @Bean
+        fun workoutFieldPatchService(): WorkoutFieldPatchService = mockk()
+
+        @Bean
+        fun workoutFinishReadinessService(): WorkoutFinishReadinessService = mockk()
+
+        @Bean
+        fun workoutResponseAssembler(): WorkoutResponseAssembler = mockk()
+    }
+
+    private companion object {
+        const val STALE_BODY =
+            """{"weight":{"kind":"BW"},"effort":null,"confirmed":false,"expected":{"weight":null,"effort":null,"confirmed":false}}"""
+    }
+}
