+/**
+ * The floor set PATCH's own request (KAN-757, decision `floor-set-request-dto`): `weight`, `effort`
+ * and `confirmed` as the solo `PatchWorkoutSetRequest` carries them, plus an optional `expected`
+ * with the same three fields — the values the phone last read, compared with the stored set under
+ * the workout row lock. Absent `expected` the PATCH is last-write-wins as today.
+ *
+ * [rejectUnknownField] mirrors the solo request: without it a misspelled key returns `200` with
+ * nothing written while the client believes it saved.
+ */
+data class PatchFloorSetRequest(
+    @field:JsonProperty(required = true)
+    val weight: SetWeightDto?,
+    @field:JsonProperty(required = true)
+    val effort: SetEffortDto?,
+    @field:JsonProperty(required = true)
+    val confirmed: Boolean,
+    val expected: FloorSetValuesDto? = null,
+) {
+    @JsonAnySetter
+    fun rejectUnknownField(
+        name: String,
+        value: Any?,
+    ): Unit =
+        throw WorkoutValidationException(
+            "The set patch endpoint accepts weight, effort, confirmed and expected only, but the body carried '$name' ($value)",
+        )
+}
+
+/** The `expected` inside [PatchFloorSetRequest]: all three fields required when it is present. */
+data class FloorSetValuesDto(
+    @field:JsonProperty(required = true)
+    val weight: SetWeightDto?,
+    @field:JsonProperty(required = true)
+    val effort: SetEffortDto?,
+    @field:JsonProperty(required = true)
+    val confirmed: Boolean,
+) {
+    @JsonAnySetter
+    fun rejectUnknownField(
+        name: String,
+        value: Any?,
+    ): Unit =
+        throw WorkoutValidationException(
+            "The expected set values accept weight, effort and confirmed only, but the body carried '$name' ($value)",
+        )
+}
