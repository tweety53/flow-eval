+
+/**
+ * The floor set PATCH's compare-and-set (KAN-757, decision `value-compare-and-set`): an optional
+ * `expected` object reaches the service beside the driver as actor, and a stale one answers `409`
+ * `set_changed` carrying the stored set, who changed it and when.
+ */
+@WebMvcTest(controllers = [GroupSessionWorkoutController::class])
+@Import(
+    GroupSessionWorkoutController::class,
+    GroupSessionExceptionHandler::class,
+    WorkoutExceptionHandler::class,
+    GroupSessionFloorSetConflictTest.TestConfig::class,
+)
+class GroupSessionFloorSetConflictTest {
+    @Autowired lateinit var mockMvc: MockMvc
+
+    @Autowired lateinit var objectMapper: ObjectMapper
+
+    @Autowired lateinit var groupSessionQueryService: GroupSessionQueryService
+
+    @Autowired lateinit var workoutFieldPatchService: WorkoutFieldPatchService
+
+    @Autowired lateinit var responses: WorkoutResponseAssembler
+
+    private val owner = UUID.fromString("11111111-1111-1111-1111-111111111111")
+    private val jana = UUID.fromString("22222222-2222-2222-2222-222222222222")
+    private val sessionId = UUID.randomUUID()
+    private val workoutId = UUID.randomUUID()
+    private val setId = UUID.randomUUID()
+    private val date = LocalDate.of(2026, 9, 4)
+
+    @BeforeEach
+    fun resetMocks() {
+        clearMocks(groupSessionQueryService, workoutFieldPatchService, responses)
+    }
+
+    private fun basePath() = "/api/group-sessions/$sessionId/participants/$jana/workout"
+
+    private val stubWorkout =
+        Workout(
+            id = workoutId,
+            userId = jana,
+            scheduledDate = date,
+            scheduledTime = null,
+            unit = WeightUnit.KG,
+            lifecycle = WorkoutLifecycle(status = WorkoutStatus.PLANNED),
+        )
+
+    private fun workoutResponse() =
+        com.gymie.workout.infrastructure.presentation.web.dto.WorkoutResponse(
+            id = workoutId,
+            scheduledDate = date,
+            scheduledTime = null,
+            unit = WeightUnit.KG,
+            name = null,
+            displayName = "Stub",
+            notes = null,
+            status = WorkoutStatus.PLANNED,
+            startedAt = null,
+            finishedAt = null,
+            blocks = emptyList(),
+        )
+
+    @Test
+    fun `expected reaches the service with the driver as actor`() {
+        val weight = SetWeight.Measured(BigDecimal("82.50"))
+        val effort = SetEffort.Count(6)
+        val expected = SetValues(SetWeight.Measured(BigDecimal("80")), SetEffort.Count(8), false)
+        every { groupSessionQueryService.participantWorkoutIdForWrite(owner, sessionId, jana) } returns workoutId
+        every {
+            workoutFieldPatchService.patchSet(jana, workoutId, setId, weight, effort, true, owner, expected)
+        } returns stubWorkout
+        every { responses.respond(stubWorkout) } returns workoutResponse()
+
+        mockMvc
+            .patch("${basePath()}/sets/$setId") {
+                with(user(owner.toString()))
+                with(csrf())
+                contentType = MediaType.APPLICATION_JSON
+                content =
+                    objectMapper.writeValueAsString(
+                        mapOf(
+                            "weight" to mapOf("kind" to "MEASURED", "value" to 82.5),
+                            "effort" to mapOf("kind" to "COUNT", "value" to 6),
+                            "confirmed" to true,
+                            "expected" to
+                                mapOf(
+                                    "weight" to mapOf("kind" to "MEASURED", "value" to 80),
+                                    "effort" to mapOf("kind" to "COUNT", "value" to 8),
+                                    "confirmed" to false,
+                                ),
+                        ),
+                    )
+            }.andExpect { status { isOk() } }
+
+        verify { workoutFieldPatchService.patchSet(jana, workoutId, setId, weight, effort, true, owner, expected) }
+    }
+
+    @Test
+    fun `a set_changed refusal carries current updatedBy and updatedAt`() {
+        val updatedAt = Instant.parse("2026-10-07T09:05:00Z")
+        val current =
+            WorkoutSet(
+                id = setId,
+                position = 0,
+                weight = SetWeight.Measured(BigDecimal("82.50")),
+                effort = SetEffort.Count(6),
+                confirmedAt = Instant.parse("2026-10-07T09:04:00Z"),
+                updatedAt = updatedAt,
+                updatedBy = owner,
+            )
+        every { groupSessionQueryService.participantWorkoutIdForWrite(owner, sessionId, jana) } returns workoutId
+        every {
+            workoutFieldPatchService.patchSet(jana, workoutId, setId, null, null, true, owner, any())
+        } throws WorkoutSetChangedException(current)
+        every { groupSessionQueryService.profileOf(owner) } returns
+            ParticipantProfile(owner, "Owner Name", "owner", null, null)
+
+        mockMvc
+            .patch("${basePath()}/sets/$setId") {
+                with(user(owner.toString()))
+                with(csrf())
+                contentType = MediaType.APPLICATION_JSON
+                content =
+                    objectMapper.writeValueAsString(
+                        mapOf(
+                            "weight" to null,
+                            "effort" to null,
+                            "confirmed" to true,
+                            "expected" to
+                                mapOf(
+                                    "weight" to null,
+                                    "effort" to null,
+                                    "confirmed" to false,
+                                ),
+                        ),
+                    )
+            }.andExpect {
+                status { isConflict() }
+                jsonPath("$.code") { value("set_changed") }
+                jsonPath("$.current.weight.kind") { value("MEASURED") }
+                jsonPath("$.current.weight.value") { value(82.5) }
+                jsonPath("$.current.effort.kind") { value("COUNT") }
+                jsonPath("$.current.effort.value") { value(6) }
+                jsonPath("$.current.confirmed") { value(true) }
+                jsonPath("$.updatedBy.id") { value(owner.toString()) }
+                jsonPath("$.updatedBy.displayName") { value("Owner Name") }
+                jsonPath("$.updatedAt") { value("2026-10-07T09:05:00Z") }
+            }
+    }
+
+    @Test
+    fun `a never-stamped set answers null updatedBy and updatedAt`() {
+        val current =
+            WorkoutSet(
+                id = setId,
+                position = 0,
+                weight = null,
+                effort = null,
+                confirmedAt = null,
+            )
+        every { groupSessionQueryService.participantWorkoutIdForWrite(owner, sessionId, jana) } returns workoutId
+        every {
+            workoutFieldPatchService.patchSet(jana, workoutId, setId, null, null, false, owner, any())
+        } throws WorkoutSetChangedException(current)
+
+        mockMvc
+            .patch("${basePath()}/sets/$setId") {
+                with(user(owner.toString()))
+                with(csrf())
+                contentType = MediaType.APPLICATION_JSON
+                content =
+                    objectMapper.writeValueAsString(
+                        mapOf(
+                            "weight" to null,
+                            "effort" to null,
+                            "confirmed" to false,
+                            "expected" to
+                                mapOf(
+                                    "weight" to mapOf("kind" to "MEASURED", "value" to 80),
+                                    "effort" to null,
+                                    "confirmed" to false,
+                                ),
+                        ),
+                    )
+            }.andExpect {
+                status { isConflict() }
+                jsonPath("$.code") { value("set_changed") }
+                jsonPath("$.current.confirmed") { value(false) }
+                jsonPath("$.updatedBy") { doesNotExist() }
+                jsonPath("$.updatedAt") { doesNotExist() }
+            }
+    }
+
+    @Test
+    fun `an unknown field is still refused`() {
+        every { groupSessionQueryService.participantWorkoutIdForWrite(owner, sessionId, jana) } returns workoutId
+
+        mockMvc
+            .patch("${basePath()}/sets/$setId") {
+                with(user(owner.toString()))
+                with(csrf())
+                contentType = MediaType.APPLICATION_JSON
+                content = """{"weight":null,"effort":null,"confirmed":true,"foo":1}"""
+            }.andExpect { status { isBadRequest() } }
+
+        verify(exactly = 0) {
+            workoutFieldPatchService.patchSet(any(), any(), any(), any(), any(), any(), any(), any())
+        }
+    }
+
+    @TestConfiguration
+    class TestConfig {
+        @Bean
+        fun groupSessionQueryService(): GroupSessionQueryService = mockk()
+
+        @Bean
+        fun workoutService(): WorkoutService = mockk()
+
+        @Bean
+        fun workoutFieldPatchService(): WorkoutFieldPatchService = mockk()
+
+        @Bean
+        fun workoutFinishReadinessService(): WorkoutFinishReadinessService = mockk()
+
+        @Bean
+        fun workoutResponseAssembler(): WorkoutResponseAssembler = mockk()
+    }
+}
