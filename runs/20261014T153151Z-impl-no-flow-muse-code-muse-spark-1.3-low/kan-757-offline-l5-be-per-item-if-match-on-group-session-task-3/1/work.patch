+/**
+ * The floor set PATCH's body: the set's new values plus the optional compare-and-set of decision
+ * `value-compare-and-set` (KAN-757). [expected] is the weight, effort and confirmed values the phone
+ * last read; absent means last-write-wins. The `@JsonProperty(required = true)` markers and the
+ * [rejectUnknownField] guard mirror
+ * [com.gymie.workout.infrastructure.presentation.web.dto.PatchWorkoutSetRequest], so a body naming
+ * anything else answers `400` instead of silently ignoring it.
+ */
+data class PatchFloorSetRequest(
+    @field:JsonProperty(required = true)
+    val weight: SetWeightDto?,
+    @field:JsonProperty(required = true)
+    val effort: SetEffortDto?,
+    @field:JsonProperty(required = true)
+    val confirmed: Boolean,
+    val expected: FloorSetValuesDto? = null,
+) {
+    @JsonAnySetter
+    fun rejectUnknownField(
+        name: String,
+        value: Any?,
+    ): Unit =
+        throw WorkoutValidationException(
+            "The floor set patch endpoint accepts weight, effort, confirmed and expected only, but the body carried '$name' ($value)",
+        )
+}
+
+/** The `expected` object of [PatchFloorSetRequest]: the set's values as the phone last read them. */
+data class FloorSetValuesDto(
+    @field:JsonProperty(required = true)
+    val weight: SetWeightDto?,
+    @field:JsonProperty(required = true)
+    val effort: SetEffortDto?,
+    @field:JsonProperty(required = true)
+    val confirmed: Boolean,
+) {
+    @JsonAnySetter
+    fun rejectUnknownField(
+        name: String,
+        value: Any?,
+    ): Unit =
+        throw WorkoutValidationException(
+            "The expected set values accept weight, effort and confirmed only, but the body carried '$name' ($value)",
+        )
+}
