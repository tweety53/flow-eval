+    /**
+     * The floor set PATCH's compare-and-set refusal (KAN-757, decision `value-compare-and-set`):
+     * nothing was written; `current` is the stored set in request shape, `updatedBy` names who last
+     * changed it and `updatedAt` when. Both stay `null` for a set no PATCH has touched since it was
+     * written. Resending with `expected` = this `current` is Keep mine.
+     */
+    @ExceptionHandler(WorkoutSetChangedException::class)
+    fun handleSetChanged(ex: WorkoutSetChangedException): ProblemDetail =
+        ProblemDetail
+            .forStatusAndDetail(HttpStatus.CONFLICT, "This set was changed on another phone.")
+            .apply {
+                setProperty("code", "set_changed")
+                setProperty(
+                    "current",
+                    mapOf(
+                        "weight" to SetWeightWebConverter.toDto(ex.current.weight),
+                        "effort" to SetEffortWebConverter.toDto(ex.current.effort),
+                        "confirmed" to (ex.current.confirmedAt != null),
+                    ),
+                )
+                // Omitted, not null, for a set no PATCH has stamped yet: ProblemDetail's NON_EMPTY
+                // inclusion drops a null property, so the client reads absence as unknown.
+                ex.current.updatedBy?.let { setProperty("updatedBy", actorOf(it)) }
+                ex.current.updatedAt?.let { setProperty("updatedAt", it) }
+            }
 }
