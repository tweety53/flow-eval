+import com.gymie.workout.core.services.workout.WorkoutFinishReadinessService
+import com.gymie.workout.core.services.workout.WorkoutService
+import com.gymie.workout.infrastructure.presentation.web.WorkoutExceptionHandler
+import com.gymie.workout.infrastructure.presentation.web.WorkoutResponseAssembler
+import io.mockk.clearMocks
+import io.mockk.every
+import io.mockk.mockk
+import io.mockk.verify
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.context.TestConfiguration
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest
+import org.springframework.context.annotation.Bean
+import org.springframework.context.annotation.Import
+import org.springframework.http.MediaType
+import org.springframework.security.test.web.servlet.request.SecurityMockMvcRequestPostProcessors.csrf
+import org.springframework.security.test.web.servlet.request.SecurityMockMvcRequestPostProcessors.user
+import org.springframework.test.web.servlet.MockMvc
+import org.springframework.test.web.servlet.patch
+import java.math.BigDecimal
+import java.time.Instant
+import java.util.UUID
+
+/**
+ * The floor set PATCH's compare-and-set (KAN-757, decision `value-compare-and-set`): `expected`
+ * handling and the `409 set_changed` body.
+ */
+@WebMvcTest(controllers = [GroupSessionWorkoutController::class])
+@Import(
+    GroupSessionWorkoutController::class,
+    GroupSessionExceptionHandler::class,
+    WorkoutExceptionHandler::class,
+    GroupSessionSetChangedProblemTest.TestConfig::class,
+)
+class GroupSessionSetChangedProblemTest {
+    @Autowired lateinit var mockMvc: MockMvc
+
+    @Autowired lateinit var groupSessionQueryService: GroupSessionQueryService
+
+    @Autowired lateinit var workoutFieldPatchService: WorkoutFieldPatchService
+
+    private val owner = UUID.fromString("11111111-1111-1111-1111-111111111111")
+    private val jana = UUID.fromString("22222222-2222-2222-2222-222222222222")
+    private val sessionId = UUID.randomUUID()
+    private val workoutId = UUID.randomUUID()
+    private val setId = UUID.randomUUID()
+    private val updatedAt = Instant.parse("2026-10-07T09:00:00Z")
+
+    @BeforeEach
+    fun resetMocks() {
+        clearMocks(groupSessionQueryService, workoutFieldPatchService)
+    }
+
+    private fun basePath() = "/api/group-sessions/$sessionId/participants/$jana/workout"
+
+    private fun patchSet(content: String) =
+        mockMvc.patch("${basePath()}/sets/$setId") {
+            with(user(owner.toString()))
+            with(csrf())
+            contentType = MediaType.APPLICATION_JSON
+            this.content = content
+        }
+
+    @Test
+    fun `an expected body delegates with the driver as actor and the converted expected values`() {
+        every { groupSessionQueryService.participantWorkoutIdForWrite(owner, sessionId, jana) } returns workoutId
+        val expected = SetValues(SetWeight.Measured(BigDecimal("60")), SetEffort.Count(10), confirmed = false)
+        every {
+            workoutFieldPatchService.patchSet(jana, workoutId, setId, null, null, true, owner, expected)
+        } throws WorkoutSetChangedException(stamped())
+        every { groupSessionQueryService.profileOf(owner) } returns
+            ParticipantProfile(owner, "Oliver Twist", "oliver", null, null)
+
+        patchSet(
+            """{"weight":null,"effort":null,"confirmed":true,"expected":""" +
+                """{"weight":{"kind":"MEASURED","value":60},"effort":{"kind":"COUNT","value":10},"confirmed":false}}""",
+        ).andExpect { status { isConflict() } }
+
+        verify {
+            workoutFieldPatchService.patchSet(jana, workoutId, setId, null, null, true, owner, expected)
+        }
+    }
+
+    @Test
+    fun `a changed set answers 409 with the current values and who changed them`() {
+        every { groupSessionQueryService.participantWorkoutIdForWrite(owner, sessionId, jana) } returns workoutId
+        every {
+            workoutFieldPatchService.patchSet(any(), any(), any(), any(), any(), any(), any(), any())
+        } throws WorkoutSetChangedException(stamped())
+        every { groupSessionQueryService.profileOf(owner) } returns
+            ParticipantProfile(owner, "Oliver Twist", "oliver", null, null)
+
+        patchSet(
+            """{"weight":null,"effort":null,"confirmed":true,"expected":{"weight":null,"effort":null,"confirmed":false}}""",
+        ).andExpect {
+            status { isConflict() }
+            jsonPath("$.detail") { value("This set was changed on another phone.") }
+            jsonPath("$.code") { value("set_changed") }
+            jsonPath("$.current.weight.kind") { value("MEASURED") }
+            jsonPath("$.current.weight.value") { value(60.0) }
+            jsonPath("$.current.effort.kind") { value("COUNT") }
+            jsonPath("$.current.effort.value") { value(10) }
+            jsonPath("$.current.confirmed") { value(true) }
+            jsonPath("$.updatedBy.id") { value(owner.toString()) }
+            jsonPath("$.updatedBy.displayName") { value("Oliver Twist") }
+            jsonPath("$.updatedAt") { value("2026-10-07T09:00:00Z") }
+        }
+    }
+
+    @Test
+    fun `an unstamped set carries no author or time`() {
+        every { groupSessionQueryService.participantWorkoutIdForWrite(owner, sessionId, jana) } returns workoutId
+        every {
+            workoutFieldPatchService.patchSet(any(), any(), any(), any(), any(), any(), any(), any())
+        } throws WorkoutSetChangedException(unstamped())
+
+        patchSet(
+            """{"weight":null,"effort":null,"confirmed":true,"expected":{"weight":null,"effort":null,"confirmed":false}}""",
+        ).andExpect {
+            status { isConflict() }
+            jsonPath("$.code") { value("set_changed") }
+            jsonPath("$.updatedBy") { doesNotExist() }
+            jsonPath("$.updatedAt") { doesNotExist() }
+        }
+    }
+
+    @Test
+    fun `an unknown field answers 400`() {
+        every { groupSessionQueryService.participantWorkoutIdForWrite(owner, sessionId, jana) } returns workoutId
+
+        patchSet("""{"weight":null,"effort":null,"confirmed":true,"foo":1}""")
+            .andExpect { status { isBadRequest() } }
+    }
+
+    private fun stamped() =
+        WorkoutSet(
+            id = setId,
+            position = 0,
+            weight = SetWeight.Measured(BigDecimal("60.00")),
+            effort = SetEffort.Count(10),
+            confirmedAt = updatedAt,
+            updatedAt = updatedAt,
+            updatedBy = owner,
+        )
+
+    private fun unstamped() =
+        WorkoutSet(
+            id = setId,
+            position = 0,
+            weight = SetWeight.Measured(BigDecimal("60.00")),
+            effort = SetEffort.Count(10),
+            confirmedAt = updatedAt,
+        )
+
+    @TestConfiguration
+    class TestConfig {
+        @Bean
+        fun groupSessionQueryService(): GroupSessionQueryService = mockk()
+
+        @Bean
+        fun workoutService(): WorkoutService = mockk()
+
+        @Bean
+        fun workoutFieldPatchService(): WorkoutFieldPatchService = mockk()
+
+        @Bean
+        fun workoutFinishReadinessService(): WorkoutFinishReadinessService = mockk()
+
+        @Bean
+        fun workoutResponseAssembler(): WorkoutResponseAssembler = mockk()
+    }
+}
