+                        "effort" to SetEffortWebConverter.toDto(current.effort),
+                        "confirmed" to (current.confirmedAt != null),
+                    ),
+                )
+                current.updatedBy?.let { setProperty("updatedBy", actorOf(it)) }
+                current.updatedAt?.let { setProperty("updatedAt", it) }
+            }
+    }
 }
