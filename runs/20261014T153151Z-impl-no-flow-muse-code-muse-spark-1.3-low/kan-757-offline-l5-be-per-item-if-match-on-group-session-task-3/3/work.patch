+        val current = ex.current
+        return ProblemDetail
+            .forStatusAndDetail(HttpStatus.CONFLICT, "This set was changed on another phone.")
+            .apply {
+                setProperty("code", "set_changed")
+                setProperty(
+                    "current",
+                    mapOf(
