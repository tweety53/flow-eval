+/**
+ * The floor's set PATCH body: the written `weight`/`effort`/`confirmed` plus the optional
+ * `expected` compare-and-set (KAN-757, decision `value-compare-and-set`) — the values the phone
+ * last read. A stored set that no longer matches them is answered `409` `set_changed` and nothing
+ * is written; without `expected` the PATCH is last-write-wins as before.
+ *
+ * A sibling of `:workout`'s
+ * [PatchWorkoutSetRequest][com.gymie.workout.infrastructure.presentation.web.dto.PatchWorkoutSetRequest],
+ * not a reuse: the solo route must keep refusing an `expected` with `400`, so the shared type
+ * cannot grow the field (design decision `floor-set-request-dto`).
+ */
+data class PatchFloorSetRequest(
+    @field:JsonProperty(required = true)
+    val weight: SetWeightDto?,
+    @field:JsonProperty(required = true)
+    val effort: SetEffortDto?,
+    @field:JsonProperty(required = true)
+    val confirmed: Boolean,
+    val expected: FloorSetValuesDto? = null,
+) {
+    @JsonAnySetter
+    fun rejectUnknownField(
+        name: String,
+        value: Any?,
+    ): Unit =
+        throw GroupSessionValidationException(
+            "The floor set patch endpoint accepts weight, effort, confirmed and expected only, but the body carried '$name' ($value)",
+        )
+}
+
+/** A set's values as the phone last read them — the wire shape of the floor PATCH's `expected`. */
+data class FloorSetValuesDto(
+    @field:JsonProperty(required = true)
+    val weight: SetWeightDto?,
+    @field:JsonProperty(required = true)
+    val effort: SetEffortDto?,
+    @field:JsonProperty(required = true)
+    val confirmed: Boolean,
+) {
+    @JsonAnySetter
+    fun rejectUnknownField(
+        name: String,
+        value: Any?,
+    ): Unit =
+        throw GroupSessionValidationException(
+            "The floor set expected object accepts weight, effort and confirmed only, but the body carried '$name' ($value)",
+        )
+}
+
 /** `POST /api/group-sessions/{id}/copy` -- [session]'s fields flattened plus [leftOut] (design § 3). */
 data class CopyGroupSessionResponse(
     @get:JsonUnwrapped val session: GroupSessionResponse,
