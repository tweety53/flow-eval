+
+    private fun workout(): Workout = stubWorkout
+
+    private fun workoutResponse() =
+        com.gymie.workout.infrastructure.presentation.web.dto.WorkoutResponse(
+            id = workoutId,
+            scheduledDate = date,
+            scheduledTime = null,
+            unit = WeightUnit.KG,
+            name = null,
+            displayName = "Stub",
+            notes = null,
+            status = WorkoutStatus.PLANNED,
+            startedAt = null,
+            finishedAt = null,
+            blocks = emptyList(),
+        )
+
+    @Test
+    fun `a body with expected delegates with the driver as actor and the converted expected`() {
+        val expected = SetValues(SetWeight.Bodyweight, SetEffort.Max, true)
+        every { groupSessionQueryService.participantWorkoutIdForWrite(owner, sessionId, jana) } returns workoutId
+        every {
+            workoutFieldPatchService.patchSet(jana, workoutId, setId, SetWeight.Bodyweight, SetEffort.Max, true, owner, expected)
+        } returns workout()
+        every { responses.respond(workout()) } returns workoutResponse()
+
+        mockMvc
+            .patch("${basePath()}/sets/$setId") {
+                with(user(owner.toString()))
+                with(csrf())
+                contentType = MediaType.APPLICATION_JSON
+                content =
+                    """{"weight":{"kind":"BW"},"effort":{"kind":"MAX"},"confirmed":true,""" +
+                    """"expected":{"weight":{"kind":"BW"},"effort":{"kind":"MAX"},"confirmed":true}}"""
+            }.andExpect { status { isOk() } }
+
+        verify {
+            workoutFieldPatchService.patchSet(jana, workoutId, setId, SetWeight.Bodyweight, SetEffort.Max, true, owner, expected)
+        }
+    }
+
+    @Test
+    fun `a changed set answers 409 carrying the current values, author and time`() {
+        val current =
+            WorkoutSet(
+                id = setId,
+                position = 0,
+                weight = SetWeight.Bodyweight,
+                effort = SetEffort.Max,
+                confirmedAt = updatedAt,
+                updatedAt = updatedAt,
+                updatedBy = updater,
+            )
+        every { groupSessionQueryService.participantWorkoutIdForWrite(owner, sessionId, jana) } returns workoutId
+        every { groupSessionQueryService.profileOf(updater) } returns ParticipantProfile(updater, "Jana Horvat", "jana", null, null)
+        every {
+            workoutFieldPatchService.patchSet(any(), any(), any(), any(), any(), any(), any(), any())
+        } throws WorkoutSetChangedException(current)
+
+        mockMvc
+            .patch("${basePath()}/sets/$setId") {
+                with(user(owner.toString()))
+                with(csrf())
+                contentType = MediaType.APPLICATION_JSON
+                content =
+                    """{"weight":null,"effort":null,"confirmed":false,"expected":{"weight":null,"effort":null,"confirmed":false}}"""
+            }.andExpect {
+                status { isConflict() }
+                jsonPath("$.detail") { value("This set was changed on another phone.") }
+                jsonPath("$.code") { value("set_changed") }
+                jsonPath("$.current.weight.kind") { value("BW") }
+                jsonPath("$.current.effort.kind") { value("MAX") }
+                jsonPath("$.current.confirmed") { value(true) }
+                jsonPath("$.updatedBy.id") { value(updater.toString()) }
+                jsonPath("$.updatedBy.displayName") { value("Jana Horvat") }
+                jsonPath("$.updatedAt") { value("2026-10-07T09:00:00Z") }
+            }
+    }
+
+    @Test
+    fun `a set stamped by nobody carries null author and time`() {
+        val current =
+            WorkoutSet(
+                id = setId,
+                position = 0,
+                weight = null,
+                effort = null,
+                confirmedAt = null,
+                updatedAt = null,
+                updatedBy = null,
+            )
+        every { groupSessionQueryService.participantWorkoutIdForWrite(owner, sessionId, jana) } returns workoutId
+        every {
+            workoutFieldPatchService.patchSet(any(), any(), any(), any(), any(), any(), any(), any())
+        } throws WorkoutSetChangedException(current)
+
+        mockMvc
+            .patch("${basePath()}/sets/$setId") {
+                with(user(owner.toString()))
+                with(csrf())
+                contentType = MediaType.APPLICATION_JSON
+                content =
+                    """{"weight":null,"effort":null,"confirmed":false,"expected":{"weight":null,"effort":null,"confirmed":false}}"""
+            }.andExpect {
+                status { isConflict() }
+                jsonPath("$.code") { value("set_changed") }
+                jsonPath("$.current.confirmed") { value(false) }
+                jsonPath("$.updatedBy") { doesNotExist() }
