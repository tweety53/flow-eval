+package com.gymie.groupsession.infrastructure.presentation.web
+
+import com.gymie.groupsession.core.domain.groupsession.specification.ParticipantProfile
+import com.gymie.groupsession.core.services.groupsession.GroupSessionQueryService
+import com.gymie.workout.core.domain.workout.SetEffort
+import com.gymie.workout.core.domain.workout.SetValues
+import com.gymie.workout.core.domain.workout.SetWeight
+import com.gymie.workout.core.domain.workout.WorkoutSet
+import com.gymie.workout.core.exceptions.WorkoutSetChangedException
+import com.gymie.workout.core.services.workout.WorkoutFieldPatchService
+import com.gymie.workout.core.services.workout.WorkoutFinishReadinessService
+import com.gymie.workout.core.services.workout.WorkoutService
+import com.gymie.workout.infrastructure.presentation.web.WorkoutExceptionHandler
+import com.gymie.workout.infrastructure.presentation.web.WorkoutResponseAssembler
+import io.mockk.clearMocks
+import io.mockk.every
+import io.mockk.mockk
+import io.mockk.verify
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.context.TestConfiguration
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest
+import org.springframework.context.annotation.Bean
+import org.springframework.context.annotation.Import
+import org.springframework.http.MediaType
+import org.springframework.security.test.web.servlet.request.SecurityMockMvcRequestPostProcessors.csrf
+import org.springframework.security.test.web.servlet.request.SecurityMockMvcRequestPostProcessors.user
+import org.springframework.test.web.servlet.MockMvc
+import org.springframework.test.web.servlet.ResultActionsDsl
+import org.springframework.test.web.servlet.patch
+import java.math.BigDecimal
+import java.time.Instant
+import java.util.UUID
+
+@WebMvcTest(controllers = [GroupSessionWorkoutController::class])
+@Import(
+    GroupSessionWorkoutController::class,
+    GroupSessionExceptionHandler::class,
+    WorkoutExceptionHandler::class,
+    GroupSessionFloorSetConflictTest.TestConfig::class,
+)
+class GroupSessionFloorSetConflictTest {
+    @Autowired lateinit var mockMvc: MockMvc
+
+    @Autowired lateinit var groupSessionQueryService: GroupSessionQueryService
+
+    @Autowired lateinit var workoutFieldPatchService: WorkoutFieldPatchService
+
+    @Autowired lateinit var workoutService: WorkoutService
+
+    @Autowired lateinit var workoutFinishReadinessService: WorkoutFinishReadinessService
+
+    @Autowired lateinit var responses: WorkoutResponseAssembler
+
+    private val owner = UUID.fromString("11111111-1111-1111-1111-111111111111")
+    private val jana = UUID.fromString("22222222-2222-2222-2222-222222222222")
+    private val driver = UUID.fromString("33333333-3333-3333-3333-333333333333")
+    private val sessionId = UUID.randomUUID()
+    private val workoutId = UUID.randomUUID()
+    private val setId = UUID.randomUUID()
+
+    @BeforeEach
+    fun resetMocks() {
+        clearMocks(groupSessionQueryService, workoutService, workoutFieldPatchService, workoutFinishReadinessService, responses)
+        every { groupSessionQueryService.participantWorkoutIdForWrite(owner, sessionId, jana) } returns workoutId
+        every { groupSessionQueryService.profileOf(driver) } returns ParticipantProfile(driver, "Ana Novak", "ana", null, null)
+    }
+
+    private fun path() = "/api/group-sessions/$sessionId/participants/$jana/workout/sets/$setId"
+
+    private fun patchAsOwner(body: String): ResultActionsDsl =
+        mockMvc.patch(path()) {
+            with(user(owner.toString()))
+            with(csrf())
+            contentType = MediaType.APPLICATION_JSON
+            content = body
+        }
+
+    @Test
+    fun `expected is passed through as the compare-and-set with the authenticated caller as actor`() {
+        every {
+            workoutFieldPatchService.patchSet(
+                jana,
+                workoutId,
+                setId,
+                SetWeight.Measured(BigDecimal("60")),
+                SetEffort.Count(8),
+                true,
+                owner,
+                SetValues(SetWeight.Measured(BigDecimal("55")), SetEffort.Count(8), false),
+            )
+        } throws WorkoutSetChangedException(stamped())
+
+        patchAsOwner(
+            """{"weight":{"kind":"MEASURED","value":60},"effort":{"kind":"COUNT","value":8},"confirmed":true,""" +
+                """"expected":{"weight":{"kind":"MEASURED","value":55},"effort":{"kind":"COUNT","value":8},"confirmed":false}}""",
+        ).andExpect { status { isConflict() } }
+
+        verify {
+            workoutFieldPatchService.patchSet(
+                jana,
+                workoutId,
+                setId,
+                SetWeight.Measured(BigDecimal("60")),
+                SetEffort.Count(8),
+                true,
+                owner,
+                SetValues(SetWeight.Measured(BigDecimal("55")), SetEffort.Count(8), false),
+            )
+        }
+    }
+
+    @Test
+    fun `a stamped set changed elsewhere answers 409 set_changed with current and the driver`() {
+        every {
+            workoutFieldPatchService.patchSet(any(), any(), any(), any(), any(), any(), any(), any())
+        } throws WorkoutSetChangedException(stamped())
+
+        patchAsOwner("""{"weight":{"kind":"MEASURED","value":60},"effort":{"kind":"COUNT","value":8},"confirmed":true}""")
+            .andExpect {
+                status { isConflict() }
+                jsonPath("$.code") { value("set_changed") }
+                jsonPath("$.detail") { value("This set was changed on another phone.") }
+                jsonPath("$.current.weight.kind") { value("MEASURED") }
+                jsonPath("$.current.weight.value") { value(60) }
+                jsonPath("$.current.effort.kind") { value("COUNT") }
+                jsonPath("$.current.effort.value") { value(8) }
+                jsonPath("$.current.confirmed") { value(true) }
+                jsonPath("$.updatedBy.id") { value(driver.toString()) }
+                jsonPath("$.updatedBy.displayName") { value("Ana Novak") }
+                jsonPath("$.updatedAt") { value("2026-10-14T09:30:00Z") }
+            }
+    }
+
+    @Test
+    fun `an unstamped set answers 409 set_changed without updatedBy or updatedAt`() {
+        every {
+            workoutFieldPatchService.patchSet(any(), any(), any(), any(), any(), any(), any(), any())
+        } throws WorkoutSetChangedException(stamped().copy(updatedAt = null, updatedBy = null))
+
+        patchAsOwner("""{"weight":null,"effort":null,"confirmed":false}""")
+            .andExpect {
+                status { isConflict() }
+                jsonPath("$.code") { value("set_changed") }
+                jsonPath("$.updatedBy") { doesNotExist() }
+                jsonPath("$.updatedAt") { doesNotExist() }
+            }
+    }
+
+    @Test
+    fun `an unknown field on the floor set body answers 400`() {
+        patchAsOwner("""{"weight":null,"effort":null,"confirmed":true,"foo":1}""")
+            .andExpect { status { isBadRequest() } }
+    }
+
+    @Test
+    fun `an unknown field inside expected answers 400`() {
+        patchAsOwner(
+            """{"weight":null,"effort":null,"confirmed":true,"expected":{"weight":null,"effort":null,"confirmed":true,"foo":1}}""",
+        ).andExpect { status { isBadRequest() } }
+    }
+
+    private fun stamped() =
+        WorkoutSet(
+            id = setId,
+            position = 1,
+            weight = SetWeight.Measured(BigDecimal("60")),
+            effort = SetEffort.Count(8),
+            confirmedAt = Instant.parse("2026-10-14T09:00:00Z"),
+            updatedAt = Instant.parse("2026-10-14T09:30:00Z"),
+            updatedBy = driver,
+        )
+
+    @TestConfiguration
+    class TestConfig {
+        @Bean
+        fun groupSessionQueryService(): GroupSessionQueryService = mockk()
+
+        @Bean
+        fun workoutService(): WorkoutService = mockk()
+
+        @Bean
+        fun workoutFieldPatchService(): WorkoutFieldPatchService = mockk()
+
+        @Bean
+        fun workoutFinishReadinessService(): WorkoutFinishReadinessService = mockk()
+
+        @Bean
+        fun workoutResponseAssembler(): WorkoutResponseAssembler = mockk()
+    }
+}
