+/**
+ * The floor's set PATCH body. [expected] is the set as the phone last read it; when present the
+ * write is compare-and-set (KAN-757, decision `value-compare-and-set`). The solo route keeps
+ * `PatchWorkoutSetRequest`, which refuses `expected` with `400`.
+ */
+data class PatchFloorSetRequest(
+    @field:JsonProperty(required = true)
+    val weight: SetWeightDto?,
+    @field:JsonProperty(required = true)
+    val effort: SetEffortDto?,
+    @field:JsonProperty(required = true)
+    val confirmed: Boolean,
+    val expected: FloorSetValuesDto? = null,
+) {
+    @JsonAnySetter
+    fun rejectUnknownField(
+        name: String,
+        value: Any?,
+    ): Unit =
+        throw WorkoutValidationException(
+            "The floor set patch endpoint accepts weight, effort, confirmed and expected only, but the body carried '$name' ($value)",
+        )
+}
+
+data class FloorSetValuesDto(
+    @field:JsonProperty(required = true)
+    val weight: SetWeightDto?,
+    @field:JsonProperty(required = true)
+    val effort: SetEffortDto?,
+    @field:JsonProperty(required = true)
+    val confirmed: Boolean,
+) {
+    @JsonAnySetter
+    fun rejectUnknownField(
+        name: String,
+        value: Any?,
+    ): Unit =
+        throw WorkoutValidationException(
+            "The expected set values accept weight, effort and confirmed only, but the body carried '$name' ($value)",
+        )
+}
