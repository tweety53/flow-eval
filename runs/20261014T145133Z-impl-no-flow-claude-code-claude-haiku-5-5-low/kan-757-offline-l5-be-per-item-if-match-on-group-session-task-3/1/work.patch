+/**
+ * The floor's set PATCH body. [expected] is the compare-and-set of decision `value-compare-and-set`
+ * (KAN-757): the values the phone last read, absent for a last-write-wins patch. [rejectUnknownField]
+ * keeps a misspelt or misplaced field from answering `200` with nothing written.
+ */
+data class PatchFloorSetRequest(
+    @field:JsonProperty(required = true)
+    val weight: SetWeightDto?,
+    @field:JsonProperty(required = true)
+    val effort: SetEffortDto?,
+    @field:JsonProperty(required = true)
+    val confirmed: Boolean,
+    val expected: FloorSetValuesDto? = null,
+) {
+    @JsonAnySetter
+    fun rejectUnknownField(
+        name: String,
+        value: Any?,
+    ): Unit =
+        throw WorkoutValidationException(
+            "The floor set patch accepts weight, effort, confirmed and expected only, but the body carried '$name' ($value)",
+        )
+}
+
+data class FloorSetValuesDto(
+    @field:JsonProperty(required = true)
+    val weight: SetWeightDto?,
+    @field:JsonProperty(required = true)
+    val effort: SetEffortDto?,
+    @field:JsonProperty(required = true)
+    val confirmed: Boolean,
+) {
+    @JsonAnySetter
+    fun rejectUnknownField(
+        name: String,
+        value: Any?,
+    ): Unit =
+        throw WorkoutValidationException(
+            "The expected set values accept weight, effort and confirmed only, but the body carried '$name' ($value)",
+        )
+}
