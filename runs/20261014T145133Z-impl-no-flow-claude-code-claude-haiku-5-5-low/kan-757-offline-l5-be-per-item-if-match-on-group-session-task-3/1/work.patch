+import org.springframework.test.web.servlet.MockMvc
+import org.springframework.test.web.servlet.patch
+import java.math.BigDecimal
+import java.time.Instant
+import java.time.LocalDate
+import java.util.UUID
+
+/** The floor set PATCH's compare-and-set and its `409 set_changed` body (KAN-757, decision `value-compare-and-set`). */
+@WebMvcTest(controllers = [GroupSessionWorkoutController::class])
+@Import(
+    GroupSessionWorkoutController::class,
+    GroupSessionExceptionHandler::class,
+    WorkoutExceptionHandler::class,
+    GroupSessionFloorSetConflictTest.TestConfig::class,
+)
+class GroupSessionFloorSetConflictTest {
+    @Autowired lateinit var mockMvc: MockMvc
+
+    @Autowired lateinit var groupSessionQueryService: GroupSessionQueryService
+
+    @Autowired lateinit var workoutFieldPatchService: WorkoutFieldPatchService
+
+    @Autowired lateinit var workoutService: WorkoutService
+
+    @Autowired lateinit var workoutFinishReadinessService: WorkoutFinishReadinessService
+
+    @Autowired lateinit var responses: WorkoutResponseAssembler
+
+    private val owner = UUID.fromString("11111111-1111-1111-1111-111111111111")
+    private val jana = UUID.fromString("22222222-2222-2222-2222-222222222222")
+    private val driver = UUID.fromString("33333333-3333-3333-3333-333333333333")
+    private val sessionId = UUID.randomUUID()
+    private val workoutId = UUID.randomUUID()
+    private val setId = UUID.randomUUID()
+    private val updatedAt = Instant.parse("2026-10-14T10:00:00Z")
+
+    @BeforeEach
+    fun resetMocks() {
+        clearMocks(groupSessionQueryService, workoutFieldPatchService, workoutService, workoutFinishReadinessService, responses)
+        every { groupSessionQueryService.participantWorkoutIdForWrite(owner, sessionId, jana) } returns workoutId
+    }
+
+    private fun basePath() = "/api/group-sessions/$sessionId/participants/$jana/workout"
+
+    private fun patchSet(body: String) =
+        mockMvc.patch("${basePath()}/sets/$setId") {
+            with(user(owner.toString()))
+            with(csrf())
+            contentType = org.springframework.http.MediaType.APPLICATION_JSON
+            content = body
+        }
+
+    @Test
+    fun `an expected body passes the driver as actor and the compare values`() {
+        every {
+            workoutFieldPatchService.patchSet(
+                jana,
+                workoutId,
+                setId,
+                SetWeight.Measured(BigDecimal("60")),
+                SetEffort.Count(8),
+                true,
+                actorId = owner,
+                expected = SetValues(SetWeight.Measured(BigDecimal("55")), SetEffort.Count(8), false),
+            )
+        } returns workout()
+        every { responses.respond(workout()) } returns workoutResponse()
+
+        patchSet(
+            """{"weight":{"kind":"MEASURED","value":60},"effort":{"kind":"COUNT","value":8},"confirmed":true,""" +
+                """"expected":{"weight":{"kind":"MEASURED","value":55},"effort":{"kind":"COUNT","value":8},"confirmed":false}}""",
+        ).andExpect { status { isOk() } }
+
+        verify {
+            workoutFieldPatchService.patchSet(
+                jana,
+                workoutId,
+                setId,
+                SetWeight.Measured(BigDecimal("60")),
+                SetEffort.Count(8),
+                true,
+                actorId = owner,
+                expected = SetValues(SetWeight.Measured(BigDecimal("55")), SetEffort.Count(8), false),
+            )
+        }
+    }
+
+    @Test
+    fun `a stale set answers 409 set_changed with its current values and last author`() {
+        val driverId = driver
+        every { groupSessionQueryService.profileOf(driverId) } returns ParticipantProfile(driverId, "Ana Kovač", "ana", null, null)
+        every { workoutFieldPatchService.patchSet(any(), any(), any(), any(), any(), any(), any(), any()) } throws
+            WorkoutSetChangedException(
+                WorkoutSet(
+                    id = setId,
+                    position = 0,
+                    weight = SetWeight.Measured(BigDecimal("55")),
+                    effort = SetEffort.Count(8),
+                    confirmedAt = null,
+                    updatedAt = updatedAt,
+                    updatedBy = driverId,
+                ),
+            )
+
+        patchSet("""{"weight":null,"effort":null,"confirmed":true,"expected":{"weight":null,"effort":null,"confirmed":false}}""")
+            .andExpect {
+                status { isConflict() }
+                jsonPath("$.detail") { value("This set was changed on another phone.") }
+                jsonPath("$.code") { value("set_changed") }
+                jsonPath("$.current.weight.kind") { value("MEASURED") }
+                jsonPath("$.current.weight.value") { value(55) }
+                jsonPath("$.current.effort.kind") { value("COUNT") }
+                jsonPath("$.current.effort.value") { value(8) }
+                jsonPath("$.current.confirmed") { value(false) }
+                jsonPath("$.updatedBy.id") { value(driverId.toString()) }
+                jsonPath("$.updatedBy.displayName") { value("Ana Kovač") }
+                jsonPath("$.updatedAt") { value("2026-10-14T10:00:00Z") }
+            }
+    }
+
+    @Test
+    fun `an unstamped set answers null updatedBy and updatedAt`() {
+        every { workoutFieldPatchService.patchSet(any(), any(), any(), any(), any(), any(), any(), any()) } throws
+            WorkoutSetChangedException(
+                WorkoutSet(
+                    id = setId,
+                    position = 0,
+                    weight = null,
+                    effort = null,
+                    confirmedAt = Instant.parse("2026-10-14T09:00:00Z"),
+                ),
+            )
+
+        patchSet("""{"weight":null,"effort":null,"confirmed":true,"expected":{"weight":null,"effort":null,"confirmed":false}}""")
+            .andExpect {
+                status { isConflict() }
+                jsonPath("$.code") { value("set_changed") }
+                jsonPath("$.current.confirmed") { value(true) }
+                jsonPath("$.updatedBy") { value(null) }
+                jsonPath("$.updatedAt") { value(null) }
+            }
+    }
+
+    @Test
+    fun `an unknown field answers 400 and writes nothing`() {
+        patchSet("""{"weight":null,"effort":null,"confirmed":true,"foo":1}""")
+            .andExpect { status { isBadRequest() } }
+
+        verify(exactly = 0) { workoutFieldPatchService.patchSet(any(), any(), any(), any(), any(), any(), any(), any()) }
+    }
+
+    private val stubWorkout =
+        Workout(
+            id = workoutId,
+            userId = jana,
+            scheduledDate = LocalDate.of(2026, 10, 14),
+            scheduledTime = null,
+            unit = WeightUnit.KG,
+            lifecycle = WorkoutLifecycle(status = WorkoutStatus.PLANNED),
+        )
+
+    private fun workout(): Workout = stubWorkout
+
+    private fun workoutResponse() =
+        com.gymie.workout.infrastructure.presentation.web.dto.WorkoutResponse(
+            id = workoutId,
+            scheduledDate = LocalDate.of(2026, 10, 14),
+            scheduledTime = null,
+            unit = WeightUnit.KG,
+            name = null,
+            displayName = "Stub",
+            notes = null,
+            status = WorkoutStatus.PLANNED,
+            startedAt = null,
+            finishedAt = null,
+            blocks = emptyList(),
+        )
+
+    @TestConfiguration
+    class TestConfig {
+        @Bean
+        fun groupSessionQueryService(): GroupSessionQueryService = mockk()
+
+        @Bean
+        fun workoutService(): WorkoutService = mockk()
+
+        @Bean
+        fun workoutFieldPatchService(): WorkoutFieldPatchService = mockk()
+
+        @Bean
+        fun workoutFinishReadinessService(): WorkoutFinishReadinessService = mockk()
+
+        @Bean
+        fun workoutResponseAssembler(): WorkoutResponseAssembler = mockk()
+    }
+}
