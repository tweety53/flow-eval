+package com.gymie.shared.cardio
+
+import com.gymie.shared.domain.WorkoutStatus
+import kotlinx.datetime.LocalDate
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+import kotlin.time.Instant
+
+class CardioLogDraftTest {
+    private val km = DistanceUnit.KM
+    private val run = CardioActivity.OUTDOOR_RUN
+
+    private fun workout(
+        activity: CardioActivity = run,
+        unit: DistanceUnit = km,
+        status: WorkoutStatus = WorkoutStatus.PLANNED,
+        startedAt: Instant? = null,
+        log: CardioLog? = null,
+        notes: String? = null,
+    ) = CardioWorkout(
+        id = "w1",
+        scheduledDate = LocalDate(2026, 10, 16),
+        displayName = "Run",
+        notes = notes,
+        status = status,
+        startedAt = startedAt,
+        activity = activity,
+        kind = activity.kinds.first(),
+        distanceUnit = unit,
+        log = log,
+    )
+
+    private fun draft(
+        activity: CardioActivity = run,
+        unit: DistanceUnit = km,
+    ) = CardioLogDraft.fresh(workout(activity, unit), Instant.parse("2026-10-16T18:00:00Z"))
+
+    @Test
+    fun eachActivityLogsItsOwnFieldsInFrameOrder() {
+        assertEquals(
+            listOf(
+                CardioLogField.DURATION,
+                CardioLogField.DISTANCE,
+                CardioLogField.AVG_PACE,
+                CardioLogField.ELEVATION_GAIN,
+                CardioLogField.AVG_HEART_RATE,
+                CardioLogField.MAX_HEART_RATE,
+                CardioLogField.AVG_CADENCE,
+                CardioLogField.CALORIES,
+                CardioLogField.EFFORT,
+                CardioLogField.NOTE,
+            ),
+            CardioActivity.OUTDOOR_RUN.logFields,
+        )
+        assertEquals(
+            listOf(
+                CardioLogField.DURATION,
+                CardioLogField.DISTANCE,
+                CardioLogField.AVG_SPEED,
+                CardioLogField.ELEVATION_GAIN,
+                CardioLogField.AVG_HEART_RATE,
+                CardioLogField.MAX_HEART_RATE,
+                CardioLogField.AVG_CADENCE,
+                CardioLogField.AVG_POWER,
+                CardioLogField.CALORIES,
+                CardioLogField.EFFORT,
+                CardioLogField.NOTE,
+            ),
+            CardioActivity.OUTDOOR_RIDE.logFields,
+        )
+        assertEquals(
+            CardioActivity.OUTDOOR_RIDE.logFields - CardioLogField.ELEVATION_GAIN,
+            CardioActivity.INDOOR_RIDE.logFields,
+        )
+        assertEquals(
+            listOf(
+                CardioLogField.DURATION,
+                CardioLogField.DISTANCE,
+                CardioLogField.AVG_PACE,
+                CardioLogField.AVG_POWER,
+                CardioLogField.AVG_HEART_RATE,
+                CardioLogField.MAX_HEART_RATE,
+                CardioLogField.AVG_CADENCE,
+                CardioLogField.CALORIES,
+                CardioLogField.EFFORT,
+                CardioLogField.NOTE,
+            ),
+            CardioActivity.ROWER.logFields,
+        )
+        assertEquals(
+            listOf(
+                CardioLogField.DURATION,
+                CardioLogField.DISTANCE,
+                CardioLogField.AVG_PACE,
+                CardioLogField.AVG_HEART_RATE,
+                CardioLogField.MAX_HEART_RATE,
+                CardioLogField.CALORIES,
+                CardioLogField.EFFORT,
+                CardioLogField.NOTE,
+            ),
+            CardioActivity.TREADMILL_RUN.logFields,
+        )
+        assertEquals(
+            listOf(
+                CardioLogField.DURATION,
+                CardioLogField.DISTANCE,
+                CardioLogField.AVG_HEART_RATE,
+                CardioLogField.MAX_HEART_RATE,
+                CardioLogField.AVG_CADENCE,
+                CardioLogField.CALORIES,
+                CardioLogField.EFFORT,
+                CardioLogField.NOTE,
+            ),
+            CardioActivity.ELLIPTICAL.logFields,
+        )
+    }
+
+    @Test
+    fun durationReadsHoursMinutesAndSeconds() {
+        val short = draft().with(CardioLogField.DURATION, "33:12").with(CardioLogField.DISTANCE, "5.02")
+        assertEquals(1992, short.toRequest().durationSeconds)
+        val long = draft().with(CardioLogField.DURATION, "1:12:40").with(CardioLogField.DISTANCE, "5.02")
+        assertEquals(4360, long.toRequest().durationSeconds)
+    }
+
+    @Test
+    fun durationRefusesOtherShapes() {
+        listOf("45", "1:75", "abc").forEach { typed ->
+            val errors = draft().with(CardioLogField.DURATION, typed).errors()
+            assertEquals("use h:mm:ss", errors[CardioLogField.DURATION], "for '$typed'")
+        }
+    }
+
+    @Test
+    fun anEmptyDurationHoldsThePrimary() {
+        val blank = draft()
+        assertFalse(blank.canSubmit)
+        assertNull(blank.errors()[CardioLogField.DURATION])
+        assertTrue(blank.with(CardioLogField.DURATION, "33:12").canSubmit)
+    }
+
+    @Test
+    fun paceIsDerivedWhenBlankAndNeverSent() {
+        val typed =
+            draft()
+                .with(CardioLogField.DURATION, "33:12")
+                .with(CardioLogField.DISTANCE, "5.02")
+        assertEquals("6:37", typed.derived(CardioLogField.AVG_PACE))
+        assertNull(typed.toRequest().avgPaceSeconds)
+    }
+
+    @Test
+    fun aTypedPaceReplacesTheDerivedOne() {
+        val typed =
+            draft()
+                .with(CardioLogField.DURATION, "33:12")
+                .with(CardioLogField.DISTANCE, "5.02")
+                .with(CardioLogField.AVG_PACE, "6:40")
+        assertNull(typed.derived(CardioLogField.AVG_PACE))
+        assertEquals(400, typed.toRequest().avgPaceSeconds)
+    }
+
+    @Test
+    fun speedIsDerivedForRides() {
+        val ride =
+            draft(CardioActivity.OUTDOOR_RIDE)
+                .with(CardioLogField.DURATION, "1:12:40")
+                .with(CardioLogField.DISTANCE, "38.6")
+        assertEquals("31.9", ride.derived(CardioLogField.AVG_SPEED))
+    }
+
+    @Test
+    fun theRowerDerivesPerFiveHundredMetres() {
+        val rower =
+            draft(CardioActivity.ROWER)
+                .with(CardioLogField.DURATION, "8:24")
+                .with(CardioLogField.DISTANCE, "2000")
+        assertEquals("2:06", rower.derived(CardioLogField.AVG_PACE))
+    }
+
+    @Test
+    fun maxBelowAvgIsAnError() {
+        val typed =
+            draft()
+                .with(CardioLogField.AVG_HEART_RATE, "148")
+                .with(CardioLogField.MAX_HEART_RATE, "139")
+        assertEquals("max heart rate is below average", typed.errors()[CardioLogField.MAX_HEART_RATE])
+        assertNull(typed.errors()[CardioLogField.AVG_HEART_RATE])
+    }
+
+    @Test
+    fun rowerCadenceOutOfRangeNamesTheRange() {
+        val rower = draft(CardioActivity.ROWER).with(CardioLogField.AVG_CADENCE, "8")
+        assertEquals("between 10 and 60 spm", rower.errors()[CardioLogField.AVG_CADENCE])
+    }
+
+    @Test
+    fun anErrorShowsOnlyOnceTheFieldWasLeft() {
+        val typed = draft().with(CardioLogField.AVG_HEART_RATE, "500")
+        assertEquals("between 30 and 250 bpm", typed.errors()[CardioLogField.AVG_HEART_RATE])
+        assertNull(typed.shownError(CardioLogField.AVG_HEART_RATE))
+        assertEquals(
+            "between 30 and 250 bpm",
+            typed.left(CardioLogField.AVG_HEART_RATE).shownError(CardioLogField.AVG_HEART_RATE),
+        )
+    }
+
+    @Test
+    fun durationPrefillsFromTheClockRoundedDown() {
+        val started = Instant.parse("2026-10-16T18:31:00Z")
+        val now = Instant.parse("2026-10-16T19:12:06.900Z")
+        val inProgress = workout(status = WorkoutStatus.IN_PROGRESS, startedAt = started)
+        val prefilled = CardioLogDraft.fresh(inProgress, now)
+        assertEquals("41:06", prefilled.text(CardioLogField.DURATION))
+    }
+
+    @Test
+    fun aSavedLogFillsTheDraft() {
+        val saved =
+            CardioLog(
+                durationSeconds = 4360,
+                distance = CardioDistance(5.02, km),
+                avgHeartRate = 150,
+                maxHeartRate = 170,
